{% if legal_note %}
  {# legal_note is sanitized HTML and legal_note_style is escaped CSS, see the
     catalog model getLegalNote() and getLegalNoteStyle() #}
  <link href="{{ legal_note_css }}" rel="stylesheet" />
  <div class="viabill-legal-note"{% if legal_note_style %} style="{{ legal_note_style }}"{% endif %}>
    <span class="viabill-legal-note-paying-with">{{ legal_note_paying_with|e }}</span>
    <span class="viabill-legal-note-logo"><img src="{{ legal_note_logo|e }}" alt="ViaBill" /></span>
    <span class="viabill-legal-note-text">{{ legal_note }}</span>
  </div>
{% endif %}
<div class="buttons">
  <div class="pull-right">
    <input type="button" value="{{ button_confirm }}" id="button-confirm" class="btn btn-primary" />
  </div>
</div>
<script type="text/javascript">
$('#button-confirm').on('click', function() {
    $.ajax({
        url: '{{ action }}',
        type: 'post',
        dataType: 'json',
        beforeSend: function() {
            $('#button-confirm').button('loading');
        },
        complete: function() {
            $('#button-confirm').button('reset');
        },
        success: function(json) {
            $('#viabill-confirm-error').remove();

            if (json['redirect']) {
                location = json['redirect'];
            } else {
                // Show why the payment could not be started (e.g. ViaBill refused the request).
                var message = json['error'] ? json['error'] : '{{ error_payment_failed|e('js') }}';

                $('#button-confirm').closest('.buttons').before($('<div id="viabill-confirm-error" class="alert alert-danger"></div>').text(message));
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
